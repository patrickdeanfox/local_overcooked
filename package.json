{
  "name": "local-overcooked",
  "version": "0.1.0",
  "description": "Two-player Overcooked clone for the browser",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "playtest": "node tools/playtest.mjs",
    "cert": "node tools/make-cert.mjs",
    "install-launcher": "bash tools/install-launcher.sh",
    "notes": "node tools/playnotes.mjs",
    "models": "node tools/sync-models.mjs",
    "skins": "python3 tools/make-chef-skins.py",
    "chef": "blender -b --python tools/export-chef.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@types/three": "^0.185.4",
    "phaser": "^3.90.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
